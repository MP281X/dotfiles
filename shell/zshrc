eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$PATH"

# Vi mode
bindkey -v
KEYTIMEOUT=1

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS APPEND_HISTORY INC_APPEND_HISTORY

# Tab completion
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
bindkey '^I' menu-complete

# Cursor shape based on vi mode
function zle-keymap-select {
	if [[ ${KEYMAP} == vicmd ]]; then
		echo -ne '\e[1 q'
	else
		echo -ne '\e[5 q'
	fi
}
function zle-line-init { echo -ne '\e[5 q' }
zle -N zle-keymap-select
zle -N zle-line-init

# fzf
export FZF_DEFAULT_OPTS='--no-hscroll --no-mouse --reverse --no-info --border=none'
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ] && source /opt/homebrew/opt/fzf/shell/completion.zsh

# Custom functions
cd() {
	builtin cd "$@" && eza --icons --group-directories-first --width 120
}

gr() {
	git fetch --prune && git branch -r | awk "{print \$1}" | grep -E -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk "{print \$1}" | xargs git branch -D
}

reset() {
	find . -type d \( -name "node_modules" -o -name "dist" -o -name ".output" -o -name ".turbo" -o -name ".tanstack" \) -exec rm -rf {} + 2>/dev/null
	find . -type f \( -name "bun.lock" -o -name ".tsbuildinfo" \) -delete 2>/dev/null
	echo "Cleaned build artifacts"
}

# Aliases
alias la="eza --icons --group-directories-first --width 120 --all"
alias ls="eza --icons --group-directories-first --width 120 --git-ignore --ignore-glob='~/.cache|~/.npm|node_modules'"
alias tree="eza --icons --group-directories-first --width 120 --tree --git-ignore --ignore-glob='~/.cache|~/.npm|node_modules'"
alias ..="cd .."
alias rm="rm -rf"
alias c="claude"

# Starship prompt
eval "$(starship init zsh)"

# Show directory listing on shell start
ls
