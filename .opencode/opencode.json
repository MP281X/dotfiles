{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": true,

	"agent": {
    "compaction": { "model": "opencode/gpt-5-nano" },
    "general": { "model": "opencode-go/minimax-m2.7" },
    "explore": { "model": "github-copilot/gpt-5.4-mini" }
  },

  "mode": {
    "build": { "model": "github-copilot/gpt-5.4" },
    "plan": { "model": "github-copilot/claude-opus-4.6" }
  },

  "permission": {
		"bash": {
			"*": "allow",
			"npm *": "deny",
			"gh *": "ask",
			"git *": "ask",
			"git *log*": "allow",
			"git *diff*": "allow",
			"git *show*": "allow",
			"git *status*": "allow",
			"git *rev-parse*": "allow"
		}
	},

  "lsp": {
    "biome": { "disabled": true }
  },

  "provider": {
		"github-copilot": {
			"models": {
				"gpt-5-mini": { "limit": { "context": 192000, "output": 64000 } },
				"claude-opus-4.6": { "limit": { "context": 192000, "output": 64000 } },
        "grok-code-fast-1": { "limit": { "context": 173000, "output": 64000 } },
        "claude-sonnet-4.6": { "limit": { "context": 200000, "output": 32000 } },
        "gemini-3.1-pro-preview": { "limit": {"context": 173000, "output": 64000} }
			}
		}
	}
}
