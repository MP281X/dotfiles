{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": true,

	"agent": {
    "general": { "model": "openai/gpt-5.4-mini" },
    "explore": { "model": "openai/gpt-5.4-mini" },
    "compaction": { "model": "openai/gpt-5.4-mini-fast" },
  },

  "mode": {
    "plan": { "disable": true },
    "build": { "model": "openai/gpt-5.5-fast" }
  },

  "tools": { "codesearch": false },
	"lsp": { "biome": { "disabled": true } },

  "permission": {
		"bash": {
			"*": "allow",
			"npm *": "deny",
			"gh *": "ask",
			"git *": "ask",
			"git *log*": "allow",
			"git *diff*": "allow",
			"git *show*": "allow",
			"git *status*": "allow",
			"git *rev-parse*": "allow"
		}
	}
}
